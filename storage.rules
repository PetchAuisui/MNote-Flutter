rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pictures embedded in a user's notes. Only the owner can touch them, and
    // only small images: this keeps usage inside the free tier.
    match /users/{uid}/images/{name} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size <= 1536 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
  }
}
